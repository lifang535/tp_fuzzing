# from tvm.script import tirx as T

@T.prim_func
def impl(mem0: T.Buffer((2, 544), "float16"), mem1: T.Buffer((2, 544), "float16"), out_e21: T.Buffer((2, 544), "float32"), out_e9: T.Buffer((2, 544), "int32"), out_e12: T.Buffer((2, 544), "bool"), out_e22: T.Buffer((2, 64), "float32"), out_e3: T.Buffer((2, 544), "float16"), out_e7: T.Buffer((2, 544), "float16"), out_e2: T.Buffer((2, 544), "bool"), steps: T.int32, limit: T.int32):
    # with T.sblock("root"):
    bx = T.launch_thread("blockIdx.x", 2)
    tx = T.launch_thread("threadIdx.x", 128)
    ty = T.launch_thread("threadIdx.y", 1)
    tz = T.launch_thread("threadIdx.z", 1)
    with T.sblock("tilelang_root"):
        T.reads()
        T.writes()
        e1 = T.sblock_alloc_buffer((32, 16), "int32", scope="local.fragment")
        e2 = T.sblock_alloc_buffer((32, 16), "bool", scope="local.fragment")
        e3 = T.sblock_alloc_buffer((32, 16), "float16", scope="local.fragment")
        e4 = T.sblock_alloc_buffer((32, 16), "float16", scope="local.fragment")
        e5 = T.sblock_alloc_buffer((32, 16), "float16", scope="local.fragment")
        e6 = T.sblock_alloc_buffer((32, 16), "float16", scope="local.fragment")
        e7 = T.sblock_alloc_buffer((32, 16), "float16", scope="local.fragment")
        e8 = T.sblock_alloc_buffer((32, 16), "int32", scope="local.fragment")
        e9 = T.sblock_alloc_buffer((32, 16), "int32", scope="local.fragment")
        e10 = T.sblock_alloc_buffer((32, 16), "int32", scope="local.fragment")
        e11 = T.sblock_alloc_buffer((32, 16), "bool", scope="local.fragment")
        e12 = T.sblock_alloc_buffer((32, 16), "bool", scope="local.fragment")
        e13 = T.sblock_alloc_buffer((32, 16), "float16", scope="local.fragment")
        e14 = T.sblock_alloc_buffer((32, 16), "float16", scope="local.fragment")
        e15 = T.sblock_alloc_buffer((32, 16), "float16", scope="local.fragment")
        e16 = T.sblock_alloc_buffer((32, 16), "int32", scope="local.fragment")
        e17 = T.sblock_alloc_buffer((32, 16), "bool", scope="local.fragment")
        e18 = T.sblock_alloc_buffer((32, 16), "float16", scope="local.fragment")
        e19 = T.sblock_alloc_buffer((32, 16), "float16", scope="local.fragment")
        e20 = T.sblock_alloc_buffer((32, 16), "float16", scope="local.fragment")
        e21 = T.sblock_alloc_buffer((32, 16), scope="local.fragment")
        e22 = T.sblock_alloc_buffer((32,), scope="local.fragment")
        e22_wide = T.sblock_alloc_buffer((32, 16), scope="local.fragment")
        for i in T.parallel(32):
            for j in T.parallel(16):
                e1[i, j] = (511 - (i * 16 + j) + 25) % 512
        for i in T.parallel(32):
            for j in T.parallel(16):
                e2[i, j] = T.bool(True)
        for i in T.parallel(32):
            for j in T.parallel(16):
                e3[i, j] = T.if_then_else(e2[i, j] and (e1[i, j] >= 0 and e1[i, j] < 512), mem0[bx, 16 + e1[i, j]], T.float16(0.0))
        for i in T.parallel(32):
            for j in T.parallel(16):
                e4[i, j] = e3[i, j] * e3[i, j]
        for i in T.parallel(32):
            for j in T.parallel(16):
                e5[i, j] = e4[i, j]
        for i in T.parallel(32):
            for j in T.parallel(16):
                e6[i, j] = T.float16(0.5)
        for i in T.parallel(32):
            for j in T.parallel(16):
                e7[i, j] = e5[i, j] * e6[i, j]
        for i in T.parallel(32):
            for j in T.parallel(16):
                e8[i, j] = 1
        for i in T.parallel(32):
            for j in T.parallel(16):
                e9[i, j] = T.bitwise_and(e1[i, j], e8[i, j])
        for i in T.parallel(32):
            for j in T.parallel(16):
                e10[i, j] = 3
        for i in T.parallel(32):
            for j in T.parallel(16):
                e11[i, j] = e9[i, j] < e10[i, j]
        for i in T.parallel(32):
            for j in T.parallel(16):
                e12[i, j] = e11[i, j] and e2[i, j]
        for i in T.parallel(32):
            for j in T.parallel(16):
                e13[i, j] = T.float16(-0.125)
        for i in T.parallel(32):
            for j in T.parallel(16):
                e14[i, j] = T.if_then_else(e12[i, j], e7[i, j], e13[i, j])
        for i in T.parallel(32):
            for j in T.parallel(16):
                e15[i, j] = e14[i, j] + e7[i, j]
        for i in T.parallel(32):
            for j in T.parallel(16):
                e16[i, j] = (511 - (i * 16 + j) + 459) % 512
        for i in T.parallel(32):
            for j in T.parallel(16):
                e17[i, j] = T.bool(True)
        for i in T.parallel(32):
            for j in T.parallel(16):
                e18[i, j] = T.if_then_else(e17[i, j] and (e16[i, j] >= 0 and e16[i, j] < 512), mem1[bx, 16 + e16[i, j]], T.float16(0.0))
        for i in T.parallel(32):
            for j in T.parallel(16):
                e19[i, j] = e15[i, j] + e18[i, j]
        for i in T.parallel(32):
            for j in T.parallel(16):
                e20[i, j] = e19[i, j] - e14[i, j]
        for i in T.parallel(32):
            for j in T.parallel(16):
                e21[i, j] = T.Cast("float32", e20[i, j])
        for i in T.parallel(32):
            for j in T.parallel(16):
                e22_wide[i, j] = e21[i, j]
        T.reduce(T.region(e22_wide[0, 0], 1, 32, 16), T.region(e22[0], 2, 32), "sum", 1, T.bool(True))
        for i in T.parallel(32):
            for j in T.parallel(16):
                out_e21[bx, 16 + (i * 16 + j)] = e21[i, j]
        for i in T.parallel(32):
            for j in T.parallel(16):
                out_e9[bx, 16 + (i * 16 + j)] = e9[i, j]
        for i in T.parallel(32):
            for j in T.parallel(16):
                out_e12[bx, 16 + (i * 16 + j)] = e12[i, j]
        for i in T.parallel(32):
            out_e22[bx, 16 + i] = e22[i]
        for i in T.parallel(32):
            for j in T.parallel(16):
                out_e3[bx, 16 + (i * 16 + j)] = e3[i, j]
        for i in T.parallel(32):
            for j in T.parallel(16):
                out_e7[bx, 16 + (i * 16 + j)] = e7[i, j]
        for i in T.parallel(32):
            for j in T.parallel(16):
                out_e2[bx, 16 + (i * 16 + j)] = e2[i, j]