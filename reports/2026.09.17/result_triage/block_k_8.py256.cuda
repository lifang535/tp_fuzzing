  for (int i = 0; i < 2; ++i) {
    *(float2*)(C + (((((((((int)threadIdx.x) & 63) >> 5) * 512) + (i * 256)) + (((((int)threadIdx.x) & 31) >> 2) * 32)) + ((((int)threadIdx.x) >> 6) * 8)) + ((((int)threadIdx.x) & 3) * 2))) = *(float2*)(cc + (i * 2));
  }
}

