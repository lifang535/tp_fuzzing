extern "C" __global__ void impl_kernel(const half_t* __restrict__ A, const half_t* __restrict__ B, float* __restrict__ C);
extern "C" __global__ void __launch_bounds__(256, 1) impl_kernel(const half_t* __restrict__ A, const half_t* __restrict__ B, float* __restrict__ C) {
  extern __shared__ __align__(1024) uchar buf_dyn_shmem[];
  void* aa = ((void*)((char*)buf_dyn_shmem + 0));
  void* bb = ((void*)((char*)buf_dyn_shmem + 512));
  float cc[4];
  float broadcast_var = 0x0p+0f/*0.000000e+00*/;
  *(float4*)(cc + 0) = make_float4(broadcast_var, broadcast_var, broadcast_var, broadcast_var);
  for (int ki = 0; ki < 4; ++ki) {
    __syncthreads();
    ((half_t*)aa)[((int)threadIdx.x)] = A[((((((int)threadIdx.x) >> 3) * 32) + (ki * 8)) + (((int)threadIdx.x) & 7))];
    ((half_t*)bb)[(((((((int)threadIdx.x) >> 5) * 32) + ((((((int)threadIdx.x) >> 7) + ((((int)threadIdx.x) & 31) >> 4)) & 1) * 16)) + (((((((int)threadIdx.x) & 127) >> 6) + ((((int)threadIdx.x) & 15) >> 3)) & 1) * 8)) + (((int)threadIdx.x) & 7))] = B[((ki * 256) + ((int)threadIdx.x))];
    {
      half_t A_local[4];
      half_t B_local[2];
      __syncthreads();
      tl::ptx_ldmatrix_x4((&(((half_t*)aa)[(((((((((int)threadIdx.x) & 63) >> 5) * 16) + ((((int)threadIdx.x) & 31) >> 4)) + (((int)threadIdx.x) & 15)) & 31) * 8)])), (&(A_local[0])));
      tl::ptx_ldmatrix_x2_trans((&(((half_t*)bb)[((((((((((int)threadIdx.x) >> 6) + ((((int)threadIdx.x) & 31) >> 4)) >> 2) + (((int)threadIdx.x) & 15)) & 7) * 32) + (((((((((((int)threadIdx.x) >> 6) + ((((int)threadIdx.x) & 31) >> 4)) >> 2) + (((int)threadIdx.x) & 15)) & 7) >> 2) + ((((((int)threadIdx.x) >> 6) + ((((int)threadIdx.x) & 31) >> 4)) & 3) >> 1)) & 1) * 16)) + (((((((((((int)threadIdx.x) >> 6) + ((((int)threadIdx.x) & 31) >> 4)) >> 2) + (((int)threadIdx.x) & 15)) & 3) >> 1) + (((((int)threadIdx.x) >> 6) + ((((int)threadIdx.x) & 31) >> 4)) & 1)) & 1) * 8))])), (&(B_local[0])));
      tl::mma_sync<tl::DataType::kFloat16, tl::DataType::kFloat16, tl::DataType::kFloat32, 16, 8, 8, false, true>(reinterpret_cast<float*>(cc + 0), reinterpret_cast<const unsigned*>(A_local + 0), reinterpret_cast<const unsigned*>(B_local + 0));
    }
  }
